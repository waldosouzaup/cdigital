# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # nunca exposta ao cliente; uso restrito (ver src/lib/supabase/admin.ts)
DATABASE_URL=                     # conexão do Drizzle para migrations (pooler, porta 5432)

# Resend
RESEND_API_KEY=
# Formato obrigatório: `email@dominio` ou `Nome <email@dominio>`. O Resend recusa
# qualquer outra forma com `validation_error: Invalid \`from\` field`, e o acento
# só é permitido no nome — nunca no endereço. Painel de deploy: cole SEM aspas.
RESEND_FROM="Comitê Digital <nao-responda@seudominio.com.br>"
RESEND_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# App
APP_URL=
CRON_SECRET=                      # protege as rotas chamadas pelo pg_cron
